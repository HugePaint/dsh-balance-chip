{
  "name": "dsh-balance-chip",
  "version": "1.2.0",
  "description": "Live account balance and peak/off-peak billing window rows in the DSH sidebar footer",
  "author": {
    "name": "Ivan Chen, HugePaint",
    "url": "https://github.com/HugePaint"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugePaint/dsh-balance-chip.git"
  },
  "homepage": "https://github.com/HugePaint/dsh-balance-chip#readme",
  "bugs": {
    "url": "https://github.com/HugePaint/dsh-balance-chip/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "billing",
    "sidebar"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "AGENT-INSTALL.md",
    "AGENT-INSTALL.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
